@@ -0,0 +1,239 @@
+//! A software renderer for egui's tessellated output: textured, vertex-coloured triangles with
+//! premultiplied alpha, drawn into an RGBA frame buffer that the window blits. No GPU is needed
+//! (AROS has no wgpu backend), and egui's own feathering does the anti-aliasing.
+
+use std::collections::HashMap;
+
+use egui::epaint::textures::{TextureFilter, TexturesDelta};
+use egui::epaint::{ClippedPrimitive, ImageData, ImageDelta, Primitive, TextureId, Vertex};
+
+struct Texture {
+    width: usize,
+    height: usize,
+    /// Premultiplied sRGBA, row by row.
+    pixels: Vec<[u8; 4]>,
+    linear: bool,
+}
+
+impl Texture {
+    #[inline]
+    fn texel(&self, x: i32, y: i32) -> [u8; 4] {
+        let x = x.clamp(0, self.width as i32 - 1) as usize;
+        let y = y.clamp(0, self.height as i32 - 1) as usize;
+        self.pixels.get(y * self.width + x).copied().unwrap_or([0; 4])
+    }
+
+    /// Samples at normalized `(u, v)`: bilinear for textures asking for it, else nearest.
+    #[inline]
+    fn sample(&self, u: f32, v: f32) -> [f32; 4] {
+        let fx = u * self.width as f32 - 0.5;
+        let fy = v * self.height as f32 - 0.5;
+        if !self.linear {
+            let t = self.texel((fx + 0.5).floor() as i32, (fy + 0.5).floor() as i32);
+            return [t[0] as f32, t[1] as f32, t[2] as f32, t[3] as f32];
+        }
+        let x0 = fx.floor();
+        let y0 = fy.floor();
+        let tx = fx - x0;
+        let ty = fy - y0;
+        let (x0, y0) = (x0 as i32, y0 as i32);
+        let a = self.texel(x0, y0);
+        let b = self.texel(x0 + 1, y0);
+        let c = self.texel(x0, y0 + 1);
+        let d = self.texel(x0 + 1, y0 + 1);
+        let mut out = [0.0f32; 4];
+        for i in 0..4 {
+            let top = a[i] as f32 * (1.0 - tx) + b[i] as f32 * tx;
+            let bottom = c[i] as f32 * (1.0 - tx) + d[i] as f32 * tx;
+            out[i] = top * (1.0 - ty) + bottom * ty;
+        }
+        out
+    }
+}
+
+pub struct Renderer {
+    textures: HashMap<TextureId, Texture>,
+    /// RGBA, `width * height * 4` bytes, opaque after `clear`.
+    pub frame: Vec<u8>,
+    pub width: usize,
+    pub height: usize,
+}
+
+impl Renderer {
+    pub fn new(width: usize, height: usize) -> Self {
+        let mut r = Self { textures: HashMap::new(), frame: Vec::new(), width: 0, height: 0 };
+        r.resize(width, height);
+        r
+    }
+
+    pub fn resize(&mut self, width: usize, height: usize) {
+        let (width, height) = (width.max(1), height.max(1));
+        if (width, height) != (self.width, self.height) {
+            self.width = width;
+            self.height = height;
+            self.frame = vec![0; width * height * 4];
+        }
+    }
+
+    pub fn stride(&self) -> usize {
+        self.width * 4
+    }
+
+    pub fn clear(&mut self, rgb: [u8; 3]) {
+        for px in self.frame.chunks_exact_mut(4) {
+            px.copy_from_slice(&[rgb[0], rgb[1], rgb[2], 255]);
+        }
+    }
+
+    /// Applies the frame's texture uploads (before painting).
+    pub fn update_textures(&mut self, delta: &TexturesDelta) {
+        for (id, deltas) in &delta.set {
+            for d in deltas {
+                self.set_texture(*id, d);
+            }
+        }
+    }
+
+    /// Frees the frame's released textures (after painting).
+    pub fn free_textures(&mut self, delta: &TexturesDelta) {
+        for id in &delta.free {
+            self.textures.remove(id);
+        }
+    }
+
+    fn set_texture(&mut self, id: TextureId, delta: &ImageDelta) {
+        let ImageData::Color(image) = &delta.image;
+        let [w, h] = image.size;
+        let linear = delta.options.magnification == TextureFilter::Linear;
+        match delta.pos {
+            None => {
+                self.textures.insert(id, Texture { width: w, height: h, pixels: image.pixels.iter().map(|c| c.to_array()).collect(), linear });
+            }
+            Some([x, y]) => {
+                let Some(t) = self.textures.get_mut(&id) else { return };
+                for row in 0..h {
+                    let ty = y + row;
+                    if ty >= t.height {
+                        break;
+                    }
+                    for col in 0..w {
+                        let tx = x + col;
+                        if tx >= t.width {
+                            break;
+                        }
+                        if let (Some(dst), Some(src)) = (t.pixels.get_mut(ty * t.width + tx), image.pixels.get(row * w + col)) {
+                            *dst = src.to_array();
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn paint(&mut self, primitives: &[ClippedPrimitive], pixels_per_point: f32) {
+        for p in primitives {
+            let Primitive::Mesh(mesh) = &p.primitive else { continue };
+            let clip = p.clip_rect;
+            let x0 = ((clip.min.x * pixels_per_point).floor() as i32).max(0);
+            let y0 = ((clip.min.y * pixels_per_point).floor() as i32).max(0);
+            let x1 = ((clip.max.x * pixels_per_point).ceil() as i32).min(self.width as i32);
+            let y1 = ((clip.max.y * pixels_per_point).ceil() as i32).min(self.height as i32);
+            if x1 <= x0 || y1 <= y0 {
+                continue;
+            }
+            let texture = self.textures.get(&mesh.texture_id);
+            for tri in mesh.indices.chunks_exact(3) {
+                let (Some(a), Some(b), Some(c)) =
+                    (mesh.vertices.get(tri[0] as usize), mesh.vertices.get(tri[1] as usize), mesh.vertices.get(tri[2] as usize))
+                else {
+                    continue;
+                };
+                triangle(&mut self.frame, self.width, [x0, y0, x1, y1], pixels_per_point, texture, a, b, c);
+            }
+        }
+    }
+}
+
+/// Rasterizes one triangle into `frame` within the clip box (pixel units, max exclusive).
+#[allow(clippy::too_many_arguments)]
+fn triangle(frame: &mut [u8], width: usize, clip: [i32; 4], ppp: f32, texture: Option<&Texture>, a: &Vertex, b: &Vertex, c: &Vertex) {
+    let (ax, ay) = (a.pos.x * ppp, a.pos.y * ppp);
+    let (bx, by) = (b.pos.x * ppp, b.pos.y * ppp);
+    let (cx, cy) = (c.pos.x * ppp, c.pos.y * ppp);
+    let area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
+    if area.abs() < 1e-6 || !area.is_finite() {
+        return;
+    }
+    let inv_area = 1.0 / area;
+    let min_x = (ax.min(bx).min(cx).floor() as i32).max(clip[0]);
+    let max_x = (ax.max(bx).max(cx).ceil() as i32).min(clip[2]);
+    let min_y = (ay.min(by).min(cy).floor() as i32).max(clip[1]);
+    let max_y = (ay.max(by).max(cy).ceil() as i32).min(clip[3]);
+    if min_x >= max_x || min_y >= max_y {
+        return;
+    }
+    let ca = a.color.to_array();
+    let cb = b.color.to_array();
+    let cc = c.color.to_array();
+    let flat_color = ca == cb && cb == cc;
+    // How each edge function changes per pixel step to the right (d/dx of the expressions below).
+    let e0_dx = by - cy;
+    let e1_dx = cy - ay;
+    let e2_dx = ay - by;
+    for py in min_y..max_y {
+        let sy = py as f32 + 0.5;
+        let sx0 = min_x as f32 + 0.5;
+        let mut w0 = (bx - sx0) * (cy - sy) - (by - sy) * (cx - sx0);
+        let mut w1 = (cx - sx0) * (ay - sy) - (cy - sy) * (ax - sx0);
+        let mut w2 = (ax - sx0) * (by - sy) - (ay - sy) * (bx - sx0);
+        // Normalized to the triangle's winding: inside when all three are >= 0.
+        let sign = if area > 0.0 { 1.0 } else { -1.0 };
+        let row = py as usize * width;
+        for px in min_x..max_x {
+            if w0 * sign >= 0.0 && w1 * sign >= 0.0 && w2 * sign >= 0.0 {
+                let l0 = w0 * inv_area;
+                let l1 = w1 * inv_area;
+                let l2 = w2 * inv_area;
+                let color = if flat_color {
+                    [ca[0] as f32, ca[1] as f32, ca[2] as f32, ca[3] as f32]
+                } else {
+                    let mut v = [0.0f32; 4];
+                    for i in 0..4 {
+                        v[i] = ca[i] as f32 * l0 + cb[i] as f32 * l1 + cc[i] as f32 * l2;
+                    }
+                    v
+                };
+                let src = match texture {
+                    Some(t) => {
+                        let u = a.uv.x * l0 + b.uv.x * l1 + c.uv.x * l2;
+                        let v = a.uv.y * l0 + b.uv.y * l1 + c.uv.y * l2;
+                        let s = t.sample(u, v);
+                        [color[0] * s[0] / 255.0, color[1] * s[1] / 255.0, color[2] * s[2] / 255.0, color[3] * s[3] / 255.0]
+                    }
+                    None => color,
+                };
+                let alpha = src[3];
+                if alpha > 0.0 {
+                    let i = (row + px as usize) * 4;
+                    if let Some(dst) = frame.get_mut(i..i + 4) {
+                        if alpha >= 254.5 {
+                            dst[0] = src[0] as u8;
+                            dst[1] = src[1] as u8;
+                            dst[2] = src[2] as u8;
+                            dst[3] = 255;
+                        } else {
+                            let keep = (255.0 - alpha) / 255.0;
+                            dst[0] = (src[0] + dst[0] as f32 * keep).min(255.0) as u8;
+                            dst[1] = (src[1] + dst[1] as f32 * keep).min(255.0) as u8;
+                            dst[2] = (src[2] + dst[2] as f32 * keep).min(255.0) as u8;
+                            dst[3] = (alpha + dst[3] as f32 * keep).min(255.0) as u8;
+                        }
+                    }
+                }
+            }
+            w0 += e0_dx;
+            w1 += e1_dx;
+            w2 += e2_dx;
+        }
+    }
+}
diff --git a/apps/photocraft-aros/src/services.rs b/apps/photocraft-aros/src/services.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8ec966d4fbb17a181a91b3fd345e60f7152d7b07
--- /dev/null
+++ b/apps/photocraft-aros/src/services.rs
@@ -0,0 +1,205 @@
+//! The platform services the UI shell needs on AROS: file requesters (asl.library), the
+//! filesystem, codecs, preferences, crash recovery. The same contract as the desktop app's
+//! `services.rs` (apps/photocraft/src/services.rs, which this follows), without rfd, arboard
+//! and the other crates that have no AROS backend.
+
+use std::cell::{Cell, RefCell};
+use std::path::{Path, PathBuf};
+use std::rc::Rc;
+use std::sync::Arc;
+
+use photocraft_codecs::{ChannelLayout, EncodeOptions, Image};
+use photocraft_doc::Document;
+use photocraft_format::RecoveryStore;
+use photocraft_ui_egui::{FileDialogAnswer, FileDialogReply, FileDialogRequest, Recoverable, Services};
+
+use crate::ffi;
+
+/// Everything File › Open reads (the desktop app's list).
+const OPEN_EXTS: &[&str] = &[
+    "pcraft", "pdn", "ora", "psd", "psb", "psdt", "png", "jpg", "jpeg", "tif", "tiff", "webp", "gif", "bmp", "tga", "ico", "qoi", "exr", "hdr", "pbm", "pgm",
+    "ppm", "pam", "pfm", "fits", "fit", "fts", "heic", "heif", "hif", "dng", "cr2", "cr3", "nef", "nrw", "arw", "pef", "orf", "rw2", "raf", "abr", "grd",
+    "svg", "svgz", "aco", "ase", "kys", "af", "afdesign", "afphoto", "afpub",
+];
+
+/// An AmigaDOS pattern matching any of `extensions` (`#?.(psd|png)`); the ASL requester matches
+/// it without regard to case.
+fn pattern(extensions: &[&str]) -> String {
+    if extensions.is_empty() {
+        return String::new();
+    }
+    format!("#?.({})", extensions.join("|"))
+}
+
+/// The settings directory: `PHOTOCRAFT_CONFIG_DIR`, else `PhotoCraftData` beside the program
+/// (`PROGDIR:`), like the desktop app's portable mode. Everything the app persists lives under it.
+pub fn config_dir() -> Option<PathBuf> {
+    if let Some(d) = std::env::var_os("PHOTOCRAFT_CONFIG_DIR").filter(|d| !d.is_empty()) {
+        return Some(PathBuf::from(d));
+    }
+    Some(PathBuf::from("PROGDIR:PhotoCraftData"))
+}
+
+pub fn prefs_file() -> Option<PathBuf> {
+    config_dir().map(|d| d.join("preferences.json"))
+}
+
+pub fn presets_dir() -> Option<PathBuf> {
+    config_dir().map(|d| d.join("Presets"))
+}
+
+fn recovery_dir() -> Option<PathBuf> {
+    config_dir().map(|d| d.join("Recovery"))
+}
+
+/// Write `bytes` crash-safely (temporary file beside the target, sync, rename).
+fn write_atomic(path: &Path, bytes: &[u8]) -> Result<(), String> {
+    photocraft_format::atomic_write(path, bytes).map_err(|e| e.to_string())
+}
+
+fn export_options(settings: &photocraft_ui_egui::ExportSettings) -> photocraft_io::ExportOptions {
+    let mut opts = photocraft_io::ExportOptions::default();
+    if let Some(q) = settings.jpeg_quality {
+        opts.encode.jpeg_quality = q;
+    }
+    opts.encode.webp_lossless = settings.webp_lossless;
+    if let Some(q) = settings.webp_quality {
+        opts.encode.webp_quality = q;
+    }
+    opts.tiff_layers = settings.tiff_layers;
+    opts.xmp = if settings.xmp_all { photocraft_io::XmpEmbed::All } else { photocraft_io::XmpEmbed::None };
+    opts.tga_bits = settings.tga_bits;
+    opts.image_previews = settings.image_previews;
+    opts
+}
+
+/// A save on a worker thread: encode, then write through `write`.
+fn save_file(
+    doc: &Document,
+    path: &str,
+    settings: &photocraft_ui_egui::ExportSettings,
+    ctl: &photocraft_ui_egui::jobs_ui::SaveCtl,
+) -> Result<Vec<String>, String> {
+    ctl.progress(0.0, "Encoding");
+    let opts = export_options(settings);
+    let r = photocraft_io::export(doc, path, &opts).map_err(|e| e.to_string())?;
+    ctl.commit()?;
+    ctl.progress(0.0, "Writing");
+    write_atomic(Path::new(path), &r.bytes)?;
+    Ok(r.warnings)
+}
+
+type SharedRecovery = Rc<RefCell<Option<RecoveryStore>>>;
+
+fn with_store<R>(store: &SharedRecovery, f: impl FnOnce(&mut RecoveryStore) -> R) -> Result<R, String> {
+    let mut slot = store.try_borrow_mut().map_err(|_| "crash recovery is busy".to_string())?;
+    Ok(f(slot.as_mut().ok_or("no config directory")?))
+}
+
+/// Crash recovery: background incremental .pcraft autosaves into `dir`.
+fn recovery_services(dir: Option<PathBuf>) -> Services {
+    let recover_dir = dir.clone();
+    let store: SharedRecovery = Rc::new(RefCell::new(dir.map(RecoveryStore::new)));
+    let (s1, s2, s4) = (store.clone(), store.clone(), store.clone());
+    Services {
+        autosave: Some(Box::new(move |doc: &Arc<Document>, revision: u64, path: Option<&str>| {
+            with_store(&s1, |s| s.autosave_checked(doc, revision, path.map(str::to_string)))?
+        })),
+        autosave_results: Some(Box::new(move || with_store(&s4, |s| s.take_completed()).unwrap_or_default())),
+        discard_autosave: Some(Box::new(move |id: u64| {
+            let _ = with_store(&s2, |s| s.discard(id));
+        })),
+        recover: Some(Box::new(move || {
+            let Some(dir) = recover_dir.as_ref() else { return Vec::new() };
+            photocraft_format::list_recovery(dir)
+                .into_iter()
+                .map(|e| Recoverable {
+                    key: e.info.key.clone(),
+                    name: e.info.document_name.clone(),
+                    path: e.info.original_path.clone(),
+                    load: Box::new(move || photocraft_format::recover(&e).map_err(|e| e.to_string())),
+                })
+                .collect()
+        })),
+        adopt_autosave: Some(Box::new(move |id: u64, key: &str| {
+            let _ = with_store(&store, |s| s.adopt(id, key));
+        })),
+        ..Default::default()
+    }
+}
+
+/// The window the requesters are parented to, shared with the event loop (the dialog runs on
+/// the main thread, modally, while the loop is inside the service call).
+pub type SharedWindow = Rc<RefCell<Option<Rc<ffi::Window>>>>;
+
+/// Shows an ASL requester for `request` and answers at once.
+fn show_file_dialog(window: &SharedWindow, last_dir: &Rc<RefCell<String>>, request: FileDialogRequest, reply: FileDialogReply) {
+    let win = window.borrow().clone();
+    let Some(win) = win else {
+        reply.send(None);
+        return;
+    };
+    let answer = match request {
+        FileDialogRequest::Open { multiple, initial_dir, extensions } => {
+            let dir = initial_dir.unwrap_or_else(|| last_dir.borrow().clone());
+            let pat = match extensions {
+                Some(exts) => pattern(&exts.iter().map(String::as_str).collect::<Vec<_>>()),
+                None => pattern(OPEN_EXTS),
+            };
+            let paths = win.file_request(false, multiple, "Open", &dir, "", &pat);
+            if let Some(first) = paths.first() {
+                *last_dir.borrow_mut() = ffi::dir_part(first).to_string();
+            }
+            (!paths.is_empty()).then_some(FileDialogAnswer::Paths(paths))
+        }
+        FileDialogRequest::Save { suggested } => {
+            let (dir, file) = (ffi::dir_part(&suggested).to_string(), ffi::file_part(&suggested).to_string());
+            let dir = if dir.is_empty() { last_dir.borrow().clone() } else { dir };
+            let paths = win.file_request(true, false, "Save As", &dir, &file, "");
+            match paths.into_iter().next() {
+                Some(p) => {
+                    *last_dir.borrow_mut() = ffi::dir_part(&p).to_string();
+                    Some(FileDialogAnswer::SaveTo(p))
+                }
+                None => None,
+            }
+        }
+    };
+    reply.send(answer);
+}
+
+/// The services for this shell. `quit` is set when the app decides to leave; `caps_lock` reads
+/// the window's last qualifiers.
+pub fn aros(window: SharedWindow, quit: Rc<Cell<bool>>) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let dialog_window = window.clone();
+    let caps_window = window;
+    Services {
+        import: Some(Box::new(|name: &str, bytes: &[u8], max_svg_group_depth: usize| {
+            photocraft_io::import_with_svg_group_depth(name, bytes, max_svg_group_depth).map(|r| (r.document, r.warnings)).map_err(|e| e.to_string())
+        })),
+        export: Some(Box::new(|doc: &Document, path: &str, settings: &photocraft_ui_egui::ExportSettings| {
+            let opts = export_options(settings);
+            photocraft_io::export(doc, path, &opts).map(|r| (r.bytes, r.warnings)).map_err(|e| e.to_string())
+        })),
+        save_file: Some(Arc::new(save_file)),
+        file_dialog: Some(Box::new(move |request, _parent, reply| show_file_dialog(&dialog_window, &last_dir, request, reply))),
+        write: Some(Box::new(|path: &str, bytes: &[u8]| write_atomic(Path::new(path), bytes))),
+        encode_png: Some(Box::new(|w, h, rgba| {
+            let img = Image::from_u8(w, h, ChannelLayout::Rgba, rgba.to_vec()).map_err(|e| e.to_string())?;
+            photocraft_codecs::encode(&img, photocraft_codecs::Format::Png, &EncodeOptions::default()).map_err(|e| e.to_string())
+        })),
+        open_url: Some(Box::new(|url: &str| if ffi::open_url(url) { Ok(()) } else { Err("OpenURL is not available".to_string()) })),
+        beep: Some(ffi::beep),
+        load_prefs: Some(Box::new(|| std::fs::read_to_string(prefs_file()?).ok())),
+        save_prefs: Some(Box::new(|text: &str| write_atomic(&prefs_file().ok_or("no config directory")?, text.as_bytes()))),
+        append_text: Some(Box::new(|path: &str, text: &str| {
+            use std::io::Write;
+            let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).map_err(|e| e.to_string())?;
+            f.write_all(text.as_bytes()).map_err(|e| e.to_string())
+        })),
+        caps_lock: Some(Box::new(move || caps_window.borrow().as_ref().is_some_and(|w| w.qualifier() & ffi::Q_CAPSLOCK != 0))),
+        quit: Some(Box::new(move || quit.set(true))),
+        ..recovery_services(recovery_dir())
+    }
+}
