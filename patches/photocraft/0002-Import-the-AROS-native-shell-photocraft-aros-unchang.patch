diff --git a/apps/photocraft-aros/build.rs b/apps/photocraft-aros/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1b8a454f5356504551a26f8aa294015fc22ceff6
--- /dev/null
+++ b/apps/photocraft-aros/build.rs
@@ -0,0 +1,45 @@
+//! Compiles the C side of the shell (`c/aros_shell.c`) with the AROS C cross compiler and links
+//! it in. The compiler and archiver come from `AROS_CC` / `AROS_AR` (the AROS build system sets
+//! them), else `<arch>-aros-cc` / `<arch>-aros-ar` on the PATH (what the Rust crosstool installs).
+//! On any other target the file is skipped, so the workspace still type-checks on the host.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=c/aros_shell.c");
+    println!("cargo:rerun-if-env-changed=AROS_CC");
+    println!("cargo:rerun-if-env-changed=AROS_AR");
+    let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    if os != "aros" {
+        return;
+    }
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let cc = std::env::var("AROS_CC").unwrap_or_else(|_| format!("{arch}-aros-cc"));
+    let ar = std::env::var("AROS_AR").unwrap_or_else(|_| format!("{arch}-aros-ar"));
+    let out = PathBuf::from(std::env::var("OUT_DIR").unwrap_or_default());
+    let obj = out.join("aros_shell.o");
+    let lib = out.join("libphotocraft_aros_shell.a");
+    let status = Command::new(&cc).args(["-O2", "-Wall", "-Wno-unused-function", "-c", "c/aros_shell.c", "-o"]).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{cc} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {cc}: {e}")),
+    }
+    let _ = std::fs::remove_file(&lib);
+    let status = Command::new(&ar).arg("crs").arg(&lib).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{ar} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {ar}: {e}")),
+    }
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=photocraft_aros_shell");
+}
+
+/// A build script reports its failure through its exit status; this is the one place a panic
+/// is the right tool.
+#[allow(clippy::panic)]
+fn panic_build(msg: &str) -> ! {
+    panic!("photocraft-aros build.rs: {msg}");
+}
diff --git a/apps/photocraft-aros/c/aros_shell.c b/apps/photocraft-aros/c/aros_shell.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b8d060c7077f3c6b32c707453ec9c5ae08550b5
--- /dev/null
+++ b/apps/photocraft-aros/c/aros_shell.c
@@ -0,0 +1,524 @@
+/*
+ * aros_shell.c - the AROS side of PhotoCraft's shell.
+ *
+ * One Intuition window on the default public screen, its IDCMP events
+ * translated into plain records the Rust event loop (src/ffi.rs) reads, the
+ * egui frame buffer blitted into it with cybergraphics, keys mapped through
+ * keymap.library, ASL file requesters, the FTXT clipboard through iffparse,
+ * and a timer.device request so the event loop can sleep until egui's next
+ * repaint is due. Everything the Rust side needs is a C function taking the
+ * handle returned by pc_window_open(); library bases come from the AROS
+ * autoinit link libraries.
+ */
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/intuition.h>
+#include <proto/graphics.h>
+#include <proto/cybergraphics.h>
+#include <proto/keymap.h>
+#include <proto/asl.h>
+#include <proto/iffparse.h>
+#include <proto/utility.h>
+
+#include <exec/memory.h>
+#include <exec/ports.h>
+#include <intuition/intuition.h>
+#include <intuition/screens.h>
+#include <cybergraphx/cybergraphics.h>
+#include <devices/inputevent.h>
+#include <devices/rawkeycodes.h>
+#include <devices/timer.h>
+#include <libraries/asl.h>
+#include <libraries/iffparse.h>
+#include <workbench/startup.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ID_FTXT MAKE_ID('F', 'T', 'X', 'T')
+#define ID_CHRS MAKE_ID('C', 'H', 'R', 'S')
+
+/* Event kinds, mirrored in src/ffi.rs. */
+enum pc_event_kind {
+    PC_EV_NONE = 0,
+    PC_EV_CLOSE = 1,
+    PC_EV_RESIZE = 2,
+    PC_EV_MOUSE_MOVE = 3,
+    PC_EV_BUTTON = 4,
+    PC_EV_KEY = 5,
+    PC_EV_WHEEL = 6,
+    PC_EV_FOCUS = 7,
+    PC_EV_REFRESH = 8,
+};
+
+/* One translated IDCMP message, mirrored in src/ffi.rs (keep the layout in sync). */
+struct pc_event {
+    int32_t kind;
+    int32_t x, y;          /* pointer position in inner-window pixels */
+    int32_t button;        /* PC_EV_BUTTON: 0 left, 1 right, 2 middle */
+    int32_t down;          /* PC_EV_BUTTON / PC_EV_KEY: pressed */
+    int32_t rawkey;        /* PC_EV_KEY: RAWKEY_* code */
+    uint32_t qualifier;    /* IEQUALIFIER_* at the time of the event */
+    int32_t wheel_x, wheel_y; /* PC_EV_WHEEL: steps, right and up positive */
+    int32_t width, height; /* PC_EV_RESIZE: the new inner size */
+    int32_t focus;         /* PC_EV_FOCUS: 1 activated, 0 deactivated */
+    char text[16];         /* PC_EV_KEY: the key with its qualifiers (system charset), NUL ended */
+    char plain[8];         /* PC_EV_KEY: the key with no qualifiers, for the logical key name */
+};
+
+struct pc_window {
+    struct Window *win;
+    struct MsgPort *timer_port;
+    struct timerequest *timer_req;
+    int timer_open;
+    int timer_pending;
+    struct Task *task;
+    LONG wake_sig;         /* signal other threads raise to wake the event loop */
+    char title[256];
+    uint32_t qualifier;    /* last seen qualifiers (Caps Lock state for the app) */
+};
+
+static void stop_timer(struct pc_window *w)
+{
+    if (w->timer_pending) {
+        if (!CheckIO((struct IORequest *)w->timer_req))
+            AbortIO((struct IORequest *)w->timer_req);
+        WaitIO((struct IORequest *)w->timer_req);
+        w->timer_pending = 0;
+    }
+}
+
+static void start_timer(struct pc_window *w, int ms)
+{
+    stop_timer(w);
+    if (!w->timer_open || ms <= 0)
+        return;
+    w->timer_req->tr_node.io_Command = TR_ADDREQUEST;
+    w->timer_req->tr_time.tv_secs = ms / 1000;
+    w->timer_req->tr_time.tv_micro = (ms % 1000) * 1000;
+    SendIO((struct IORequest *)w->timer_req);
+    w->timer_pending = 1;
+}
+
+/* The public screen's size, for placing and limiting the window. */
+void pc_screen_size(int32_t *width, int32_t *height)
+{
+    struct Screen *scr = LockPubScreen(NULL);
+    *width = 1024;
+    *height = 768;
+    if (scr) {
+        *width = scr->Width;
+        *height = scr->Height;
+        UnlockPubScreen(NULL, scr);
+    }
+}
+
+struct pc_window *pc_window_open(int32_t width, int32_t height, const char *title)
+{
+    struct pc_window *w = calloc(1, sizeof *w);
+    int32_t sw, sh;
+    if (!w)
+        return NULL;
+    strncpy(w->title, title ? title : "PhotoCraft", sizeof w->title - 1);
+    w->task = FindTask(NULL);
+    w->wake_sig = AllocSignal(-1);
+    if (w->wake_sig >= 0)
+        SetSignal(0, 1UL << w->wake_sig);
+
+    pc_screen_size(&sw, &sh);
+    if (width > sw - 16) width = sw - 16;
+    if (height > sh - 48) height = sh - 48;
+    if (width < 320) width = 320;
+    if (height < 240) height = 240;
+
+    w->win = OpenWindowTags(NULL,
+        WA_Left, (sw - width) / 2 > 0 ? (sw - width) / 2 : 0,
+        WA_Top, (sh - height) / 2 > 0 ? (sh - height) / 2 : 0,
+        WA_InnerWidth, width,
+        WA_InnerHeight, height,
+        WA_MinWidth, 320,
+        WA_MinHeight, 240,
+        WA_MaxWidth, ~0,
+        WA_MaxHeight, ~0,
+        WA_Title, (IPTR)w->title,
+        WA_Flags, WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_CLOSEGADGET | WFLG_SIZEGADGET
+                | WFLG_SIZEBBOTTOM | WFLG_ACTIVATE | WFLG_REPORTMOUSE | WFLG_RMBTRAP
+                | WFLG_GIMMEZEROZERO | WFLG_NOCAREREFRESH,
+        WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_MOUSEBUTTONS | IDCMP_MOUSEMOVE
+                | IDCMP_RAWKEY | IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW,
+        TAG_DONE);
+    if (!w->win) {
+        if (w->wake_sig >= 0) FreeSignal(w->wake_sig);
+        free(w);
+        return NULL;
+    }
+
+    w->timer_port = CreateMsgPort();
+    if (w->timer_port) {
+        SetSignal(0, 1UL << w->timer_port->mp_SigBit);
+        w->timer_req = (struct timerequest *)CreateIORequest(w->timer_port, sizeof(struct timerequest));
+        if (w->timer_req && OpenDevice((CONST_STRPTR)"timer.device", UNIT_MICROHZ, (struct IORequest *)w->timer_req, 0) == 0)
+            w->timer_open = 1;
+    }
+    return w;
+}
+
+void pc_window_close(struct pc_window *w)
+{
+    if (!w)
+        return;
+    stop_timer(w);
+    if (w->timer_open)
+        CloseDevice((struct IORequest *)w->timer_req);
+    if (w->timer_req)
+        DeleteIORequest((struct IORequest *)w->timer_req);
+    if (w->timer_port)
+        DeleteMsgPort(w->timer_port);
+    if (w->win)
+        CloseWindow(w->win);
+    if (w->wake_sig >= 0)
+        FreeSignal(w->wake_sig);
+    free(w);
+}
+
+void pc_window_inner_size(struct pc_window *w, int32_t *width, int32_t *height)
+{
+    *width = w->win->GZZWidth;
+    *height = w->win->GZZHeight;
+}
+
+/* Sleeps until a window message, a wake-up from pc_window_wake() or the
+ * timeout (milliseconds; negative waits for messages only). Returns 1 when a
+ * window message or wake-up arrived, 0 on timeout. The timer is judged by its
+ * request (CheckIO), never by its signal alone: a signal bit can be left set
+ * from an earlier use, and that must not count as a timeout. */
+int32_t pc_window_wait(struct pc_window *w, int32_t timeout_ms)
+{
+    ULONG winsig = 1UL << w->win->UserPort->mp_SigBit;
+    ULONG wakesig = w->wake_sig >= 0 ? 1UL << w->wake_sig : 0;
+    ULONG timersig = 0;
+    ULONG got;
+
+    /* egui wants the next frame at once: still block for a moment so the
+     * other tasks run (the file-open and save workers, the font scan); a
+     * frame loop that never waits starves them. A millisecond is nothing
+     * next to a software-rendered frame. */
+    if (timeout_ms == 0)
+        timeout_ms = w->timer_open ? 1 : 0;
+    if (timeout_ms == 0)
+        return 1;
+    if (w->timer_open && timeout_ms > 0) {
+        start_timer(w, timeout_ms);
+        timersig = 1UL << w->timer_port->mp_SigBit;
+    }
+    for (;;) {
+        got = Wait(winsig | wakesig | timersig);
+        if (got & (winsig | wakesig)) {
+            stop_timer(w);
+            return 1;
+        }
+        if (w->timer_pending && CheckIO((struct IORequest *)w->timer_req)) {
+            WaitIO((struct IORequest *)w->timer_req);
+            w->timer_pending = 0;
+            return 0;
+        }
+        if (!timersig)
+            return 1;
+        /* a stale timer signal: the request is still running, keep waiting */
+    }
+}
+
+/* Wakes the event loop from any task (egui's request_repaint from a worker thread). */
+void pc_window_wake(struct pc_window *w)
+{
+    if (w && w->wake_sig >= 0)
+        Signal(w->task, 1UL << w->wake_sig);
+}
+
+static void map_key(struct pc_window *w, struct IntuiMessage *imsg, struct pc_event *ev)
+{
+    struct InputEvent ie;
+    UWORD code = imsg->Code & ~IECODE_UP_PREFIX;
+    LONG n;
+
+    memset(&ie, 0, sizeof ie);
+    ie.ie_Class = IECLASS_RAWKEY;
+    ie.ie_Code = code;
+    /* Control and Amiga combinations map to control characters; the app wants
+     * the plain key under them, so those qualifiers are left out here. */
+    ie.ie_Qualifier = imsg->Qualifier & ~(IEQUALIFIER_CONTROL | IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND);
+    if (imsg->IAddress)
+        ie.ie_EventAddress = (APTR *)*((IPTR *)imsg->IAddress);
+    n = MapRawKey(&ie, (STRPTR)ev->text, sizeof ev->text - 1, NULL);
+    if (n < 0) n = 0;
+    ev->text[n] = 0;
+
+    ie.ie_Qualifier = 0;
+    ie.ie_EventAddress = NULL;
+    n = MapRawKey(&ie, (STRPTR)ev->plain, sizeof ev->plain - 1, NULL);
+    if (n < 0) n = 0;
+    ev->plain[n] = 0;
+    (void)w;
+}
+
+/* Fills the next translated event; returns 0 when there is none waiting. */
+int32_t pc_window_poll(struct pc_window *w, struct pc_event *ev)
+{
+    struct IntuiMessage *imsg;
+
+    memset(ev, 0, sizeof *ev);
+    while ((imsg = (struct IntuiMessage *)GetMsg(w->win->UserPort))) {
+        ULONG cls = imsg->Class;
+        UWORD code = imsg->Code;
+        UWORD qual = imsg->Qualifier;
+        /* The message's position is relative to the outer window; the frame is the
+         * GimmeZeroZero inner area, which starts after the borders. */
+        WORD mx = imsg->MouseX - w->win->BorderLeft, my = imsg->MouseY - w->win->BorderTop;
+
+        w->qualifier = qual;
+        ev->x = mx;
+        ev->y = my;
+        ev->qualifier = qual;
+
+        switch (cls) {
+        case IDCMP_CLOSEWINDOW:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = PC_EV_CLOSE;
+            return 1;
+        case IDCMP_NEWSIZE:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = PC_EV_RESIZE;
+            ev->width = w->win->GZZWidth;
+            ev->height = w->win->GZZHeight;
+            return 1;
+        case IDCMP_MOUSEMOVE:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = PC_EV_MOUSE_MOVE;
+            return 1;
+        case IDCMP_MOUSEBUTTONS:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = PC_EV_BUTTON;
+            ev->down = (code & IECODE_UP_PREFIX) ? 0 : 1;
+            switch (code & ~IECODE_UP_PREFIX) {
+            case IECODE_LBUTTON: ev->button = 0; break;
+            case IECODE_RBUTTON: ev->button = 1; break;
+            case IECODE_MBUTTON: ev->button = 2; break;
+            default: ev->kind = PC_EV_NONE; continue;
+            }
+            return 1;
+        case IDCMP_RAWKEY: {
+            UWORD key = code & ~IECODE_UP_PREFIX;
+            if (key >= RAWKEY_NM_WHEEL_UP && key <= RAWKEY_NM_WHEEL_RIGHT) {
+                ReplyMsg((struct Message *)imsg);
+                if (code & IECODE_UP_PREFIX)
+                    continue;
+                ev->kind = PC_EV_WHEEL;
+                switch (key) {
+                case RAWKEY_NM_WHEEL_UP: ev->wheel_y = 1; break;
+                case RAWKEY_NM_WHEEL_DOWN: ev->wheel_y = -1; break;
+                case RAWKEY_NM_WHEEL_LEFT: ev->wheel_x = -1; break;
+                default: ev->wheel_x = 1; break;
+                }
+                return 1;
+            }
+            ev->kind = PC_EV_KEY;
+            ev->rawkey = key;
+            ev->down = (code & IECODE_UP_PREFIX) ? 0 : 1;
+            if (ev->down)
+                map_key(w, imsg, ev);
+            ReplyMsg((struct Message *)imsg);
+            return 1;
+        }
+        case IDCMP_ACTIVEWINDOW:
+        case IDCMP_INACTIVEWINDOW:
+            ReplyMsg((struct Message *)imsg);
+            ev->kind = PC_EV_FOCUS;
+            ev->focus = cls == IDCMP_ACTIVEWINDOW;
+            return 1;
+        default:
+            ReplyMsg((struct Message *)imsg);
+            continue;
+        }
+    }
+    return 0;
+}
+
+uint32_t pc_window_qualifier(struct pc_window *w)
+{
+    return w->qualifier;
+}
+
+/* Copies an RGBA (byte order R, G, B, A) frame buffer into the window's inner area. */
+void pc_window_blit(struct pc_window *w, const uint8_t *rgba, int32_t width, int32_t height, int32_t stride)
+{
+    int32_t iw = w->win->GZZWidth, ih = w->win->GZZHeight;
+    if (width > iw) width = iw;
+    if (height > ih) height = ih;
+    if (width <= 0 || height <= 0)
+        return;
+    WritePixelArray((APTR)rgba, 0, 0, stride, w->win->RPort, 0, 0, width, height, RECTFMT_RGBA);
+}
+
+void pc_window_set_busy(struct pc_window *w, int32_t busy)
+{
+    SetWindowPointer(w->win, WA_BusyPointer, busy ? TRUE : FALSE, TAG_DONE);
+}
+
+void pc_window_set_title(struct pc_window *w, const char *title)
+{
+    strncpy(w->title, title ? title : "", sizeof w->title - 1);
+    w->title[sizeof w->title - 1] = 0;
+    SetWindowTitles(w->win, (CONST_STRPTR)w->title, (CONST_STRPTR)~0);
+}
+
+void pc_window_activate(struct pc_window *w)
+{
+    ActivateWindow(w->win);
+}
+
+/* The event loop's task priority. A task that keeps the CPU is not time-sliced
+ * against equal-priority tasks on every AROS flavour, so while background
+ * work runs (file opens and saves, the font scan) the loop drops below the
+ * workers' priority 0 and only draws when they wait. */
+void pc_window_set_priority(struct pc_window *w, int32_t pri)
+{
+    SetTaskPri(w->task, pri);
+}
+
+void pc_beep(void)
+{
+    DisplayBeep(NULL);
+}
+
+/*
+ * An ASL file requester. `save` selects save mode, `multi` multi-selection;
+ * `dir`, `file` and `pattern` may be empty. The chosen paths are written to
+ * `out`, separated by newlines; returns the number of paths (0: cancelled or
+ * nothing fits).
+ */
+int32_t pc_file_request(struct pc_window *w, int32_t save, int32_t multi, const char *title,
+                        const char *dir, const char *file, const char *pattern, char *out, int32_t outlen)
+{
+    struct FileRequester *req;
+    int32_t count = 0;
+    char path[1024];
+
+    if (!out || outlen < 2)
+        return 0;
+    out[0] = 0;
+    req = AllocAslRequestTags(ASL_FileRequest,
+        ASLFR_Window, (IPTR)(w ? w->win : NULL),
+        ASLFR_TitleText, (IPTR)(title ? title : "Select file"),
+        ASLFR_InitialDrawer, (IPTR)(dir ? dir : ""),
+        ASLFR_InitialFile, (IPTR)(file ? file : ""),
+        ASLFR_DoSaveMode, save ? TRUE : FALSE,
+        ASLFR_DoMultiSelect, (multi && !save) ? TRUE : FALSE,
+        ASLFR_DoPatterns, (pattern && pattern[0]) ? TRUE : FALSE,
+        ASLFR_InitialPattern, (IPTR)((pattern && pattern[0]) ? pattern : "#?"),
+        ASLFR_RejectIcons, TRUE,
+        TAG_DONE);
+    if (!req)
+        return 0;
+    if (AslRequestTags(req, TAG_DONE)) {
+        if (multi && !save && req->fr_NumArgs > 0) {
+            LONG i;
+            for (i = 0; i < req->fr_NumArgs; i++) {
+                strncpy(path, req->fr_Drawer ? (const char *)req->fr_Drawer : "", sizeof path - 1);
+                path[sizeof path - 1] = 0;
+                if (!AddPart((STRPTR)path, (CONST_STRPTR)req->fr_ArgList[i].wa_Name, sizeof path))
+                    continue;
+                if (strlen(out) + strlen(path) + 2 > (size_t)outlen)
+                    break;
+                if (count)
+                    strcat(out, "\n");
+                strcat(out, path);
+                count++;
+            }
+        } else if (req->fr_File && req->fr_File[0]) {
+            strncpy(path, req->fr_Drawer ? (const char *)req->fr_Drawer : "", sizeof path - 1);
+            path[sizeof path - 1] = 0;
+            if (AddPart((STRPTR)path, (CONST_STRPTR)req->fr_File, sizeof path) && strlen(path) + 1 <= (size_t)outlen) {
+                strcpy(out, path);
+                count = 1;
+            }
+        }
+    }
+    FreeAslRequest(req);
+    return count;
+}
+
+/* Writes `len` bytes of text (system charset) to the clipboard as FTXT. */
+int32_t pc_clip_write_text(const char *text, int32_t len)
+{
+    struct IFFHandle *iff = AllocIFF();
+    int32_t ok = 0;
+    if (!iff)
+        return 0;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (OpenIFF(iff, IFFF_WRITE) == 0) {
+            if (PushChunk(iff, ID_FTXT, ID_FORM, IFFSIZE_UNKNOWN) == 0) {
+                if (PushChunk(iff, 0, ID_CHRS, len) == 0) {
+                    ok = WriteChunkBytes(iff, (APTR)text, len) == len;
+                    PopChunk(iff);
+                }
+                PopChunk(iff);
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff);
+    return ok;
+}
+
+/* Reads the clipboard's FTXT text into `out` (NUL ended); returns its length, or 0. */
+int32_t pc_clip_read_text(char *out, int32_t outlen)
+{
+    struct IFFHandle *iff = AllocIFF();
+    int32_t total = 0;
+    if (!iff || !out || outlen < 1)
+        return 0;
+    out[0] = 0;
+    iff->iff_Stream = (IPTR)OpenClipboard(0);
+    if (iff->iff_Stream) {
+        InitIFFasClip(iff);
+        if (OpenIFF(iff, IFFF_READ) == 0) {
+            if (StopChunk(iff, ID_FTXT, ID_CHRS) == 0) {
+                while (ParseIFF(iff, IFFPARSE_SCAN) == 0) {
+                    struct ContextNode *cn = CurrentChunk(iff);
+                    if (cn && cn->cn_Type == ID_FTXT && cn->cn_ID == ID_CHRS) {
+                        LONG want = cn->cn_Size;
+                        if (want > outlen - 1 - total)
+                            want = outlen - 1 - total;
+                        if (want > 0) {
+                            LONG got = ReadChunkBytes(iff, out + total, want);
+                            if (got > 0)
+                                total += got;
+                        }
+                    }
+                }
+            }
+            CloseIFF(iff);
+        }
+        CloseClipboard((struct ClipboardHandle *)iff->iff_Stream);
+    }
+    FreeIFF(iff);
+    out[total] = 0;
+    return total;
+}
+
+/* Hands a URL to the system's OpenURL command (openurl.library's front end). */
+int32_t pc_open_url(const char *url)
+{
+    char cmd[2048];
+    if (!url || strlen(url) > sizeof cmd - 16)
+        return 0;
+    strcpy(cmd, "OpenURL \"");
+    strcat(cmd, url);
+    strcat(cmd, "\"");
+    return SystemTags((CONST_STRPTR)cmd, SYS_Asynch, FALSE, TAG_DONE) == 0;
+}
diff --git a/apps/photocraft-aros/src/ffi.rs b/apps/photocraft-aros/src/ffi.rs
new file mode 100644
index 0000000000000000000000000000000000000000..53465eaba382b58534cc4e9537ce268b642a1f2e
--- /dev/null
+++ b/apps/photocraft-aros/src/ffi.rs
@@ -0,0 +1,298 @@
+//! The C side of the shell (`c/aros_shell.c`), wrapped for the Rust event loop: the window and
+//! its events, the frame buffer blit, the timer-backed wait, ASL requesters, the clipboard.
+//!
+//! `pc_event` and the event kinds mirror the C definitions; keep them in sync.
+
+use std::ffi::{CStr, CString};
+use std::os::raw::{c_char, c_int};
+
+pub const EV_CLOSE: i32 = 1;
+pub const EV_RESIZE: i32 = 2;
+pub const EV_MOUSE_MOVE: i32 = 3;
+pub const EV_BUTTON: i32 = 4;
+pub const EV_KEY: i32 = 5;
+pub const EV_WHEEL: i32 = 6;
+pub const EV_FOCUS: i32 = 7;
+
+/// `IEQUALIFIER_*` bits (devices/inputevent.h).
+pub const Q_LSHIFT: u32 = 1 << 0;
+pub const Q_RSHIFT: u32 = 1 << 1;
+pub const Q_CAPSLOCK: u32 = 1 << 2;
+pub const Q_CONTROL: u32 = 1 << 3;
+pub const Q_LALT: u32 = 1 << 4;
+pub const Q_RALT: u32 = 1 << 5;
+pub const Q_LCOMMAND: u32 = 1 << 6;
+pub const Q_RCOMMAND: u32 = 1 << 7;
+pub const Q_REPEAT: u32 = 1 << 9;
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct PcEvent {
+    pub kind: i32,
+    pub x: i32,
+    pub y: i32,
+    pub button: i32,
+    pub down: i32,
+    pub rawkey: i32,
+    pub qualifier: u32,
+    pub wheel_x: i32,
+    pub wheel_y: i32,
+    pub width: i32,
+    pub height: i32,
+    pub focus: i32,
+    pub text: [u8; 16],
+    pub plain: [u8; 8],
+}
+
+impl PcEvent {
+    fn zeroed() -> Self {
+        Self {
+            kind: 0,
+            x: 0,
+            y: 0,
+            button: 0,
+            down: 0,
+            rawkey: 0,
+            qualifier: 0,
+            wheel_x: 0,
+            wheel_y: 0,
+            width: 0,
+            height: 0,
+            focus: 0,
+            text: [0; 16],
+            plain: [0; 8],
+        }
+    }
+
+    /// The typed characters, converted from the system charset (ISO 8859-1 on AROS) to UTF-8.
+    pub fn text(&self) -> String {
+        latin1(&self.text)
+    }
+
+    /// The key with no qualifiers held, for naming the logical key.
+    pub fn plain(&self) -> String {
+        latin1(&self.plain)
+    }
+}
+
+fn latin1(bytes: &[u8]) -> String {
+    bytes.iter().take_while(|&&b| b != 0).map(|&b| b as char).collect()
+}
+
+#[repr(C)]
+pub struct PcWindow {
+    _private: [u8; 0],
+}
+
+unsafe extern "C" {
+    fn pc_screen_size(width: *mut i32, height: *mut i32);
+    fn pc_window_open(width: i32, height: i32, title: *const c_char) -> *mut PcWindow;
+    fn pc_window_close(w: *mut PcWindow);
+    fn pc_window_inner_size(w: *mut PcWindow, width: *mut i32, height: *mut i32);
+    fn pc_window_wait(w: *mut PcWindow, timeout_ms: i32) -> i32;
+    fn pc_window_wake(w: *mut PcWindow);
+    fn pc_window_poll(w: *mut PcWindow, ev: *mut PcEvent) -> i32;
+    fn pc_window_qualifier(w: *mut PcWindow) -> u32;
+    fn pc_window_blit(w: *mut PcWindow, rgba: *const u8, width: i32, height: i32, stride: i32);
+    fn pc_window_set_busy(w: *mut PcWindow, busy: i32);
+    fn pc_window_set_title(w: *mut PcWindow, title: *const c_char);
+    fn pc_beep();
+    fn pc_file_request(
+        w: *mut PcWindow,
+        save: i32,
+        multi: i32,
+        title: *const c_char,
+        dir: *const c_char,
+        file: *const c_char,
+        pattern: *const c_char,
+        out: *mut c_char,
+        outlen: i32,
+    ) -> i32;
+    fn pc_clip_write_text(text: *const c_char, len: i32) -> i32;
+    fn pc_clip_read_text(out: *mut c_char, outlen: i32) -> i32;
+    fn pc_open_url(url: *const c_char) -> c_int;
+    fn pc_window_set_priority(w: *mut PcWindow, pri: i32);
+}
+
+fn cstring(s: &str) -> CString {
+    // Interior NULs cannot be passed through; the text is cut at the first one.
+    CString::new(s.split('\0').next().unwrap_or("")).unwrap_or_default()
+}
+
+/// Converts UTF-8 to the system charset (ISO 8859-1), replacing what it cannot represent.
+fn to_latin1(s: &str) -> Vec<u8> {
+    s.chars().map(|c| if (c as u32) < 256 { c as u32 as u8 } else { b'?' }).collect()
+}
+
+/// The screen's size in pixels.
+pub fn screen_size() -> (i32, i32) {
+    let (mut w, mut h) = (0, 0);
+    // SAFETY: plain out-parameters.
+    unsafe { pc_screen_size(&mut w, &mut h) };
+    (w, h)
+}
+
+/// The shell's window. Lives on the main thread; only [`Waker`] crosses threads.
+pub struct Window {
+    raw: *mut PcWindow,
+}
+
+/// Wakes the event loop from another thread (egui's repaint requests from workers).
+#[derive(Clone, Copy)]
+pub struct Waker(*mut PcWindow);
+
+// SAFETY: pc_window_wake only raises an exec signal for the main task, which is safe from any
+// task; the pointer is never dereferenced on the other thread beyond that call, and the window
+// outlives every worker that holds a waker (the app, and its workers, are dropped before it).
+unsafe impl Send for Waker {}
+unsafe impl Sync for Waker {}
+
+impl Waker {
+    pub fn wake(&self) {
+        // SAFETY: see the Send impl.
+        unsafe { pc_window_wake(self.0) }
+    }
+}
+
+impl Window {
+    pub fn open(width: i32, height: i32, title: &str) -> Option<Self> {
+        let title = cstring(title);
+        // SAFETY: the title outlives the call (the C side copies it).
+        let raw = unsafe { pc_window_open(width, height, title.as_ptr()) };
+        if raw.is_null() { None } else { Some(Self { raw }) }
+    }
+
+    pub fn waker(&self) -> Waker {
+        Waker(self.raw)
+    }
+
+    pub fn inner_size(&self) -> (i32, i32) {
+        let (mut w, mut h) = (0, 0);
+        // SAFETY: valid window, plain out-parameters.
+        unsafe { pc_window_inner_size(self.raw, &mut w, &mut h) };
+        (w.max(1), h.max(1))
+    }
+
+    /// Sleeps until an event or a wake-up, or for `timeout_ms` (negative: no timeout).
+    pub fn wait(&self, timeout_ms: i32) -> bool {
+        // SAFETY: valid window.
+        unsafe { pc_window_wait(self.raw, timeout_ms) != 0 }
+    }
+
+    pub fn poll(&self) -> Option<PcEvent> {
+        let mut ev = PcEvent::zeroed();
+        // SAFETY: valid window and a properly laid out event record.
+        let got = unsafe { pc_window_poll(self.raw, &mut ev) };
+        (got != 0).then_some(ev)
+    }
+
+    pub fn qualifier(&self) -> u32 {
+        // SAFETY: valid window.
+        unsafe { pc_window_qualifier(self.raw) }
+    }
+
+    /// Copies an RGBA frame buffer (`stride` bytes per row) into the window.
+    pub fn blit(&self, rgba: &[u8], width: usize, height: usize, stride: usize) {
+        if rgba.len() < stride * height || width == 0 || height == 0 {
+            return;
+        }
+        // SAFETY: the buffer holds `height` rows of `stride` bytes, checked above.
+        unsafe { pc_window_blit(self.raw, rgba.as_ptr(), width as i32, height as i32, stride as i32) };
+    }
+
+    pub fn set_busy(&self, busy: bool) {
+        // SAFETY: valid window.
+        unsafe { pc_window_set_busy(self.raw, busy as i32) }
+    }
+
+    /// The event loop's task priority (see the C side).
+    pub fn set_priority(&self, pri: i32) {
+        // SAFETY: valid window.
+        unsafe { pc_window_set_priority(self.raw, pri) }
+    }
+
+    pub fn set_title(&self, title: &str) {
+        let title = cstring(title);
+        // SAFETY: the C side copies the string before returning.
+        unsafe { pc_window_set_title(self.raw, title.as_ptr()) }
+    }
+
+    /// Shows an ASL file requester (modal) and returns the chosen paths.
+    pub fn file_request(&self, save: bool, multi: bool, title: &str, dir: &str, file: &str, pattern: &str) -> Vec<String> {
+        let (title, dir, file, pattern) = (cstring(title), cstring(dir), cstring(file), cstring(pattern));
+        let mut out = vec![0u8; 16 * 1024];
+        // SAFETY: all strings are NUL-terminated and outlive the call; `out` is `outlen` bytes.
+        let n = unsafe {
+            pc_file_request(
+                self.raw,
+                save as i32,
+                multi as i32,
+                title.as_ptr(),
+                dir.as_ptr(),
+                file.as_ptr(),
+                pattern.as_ptr(),
+                out.as_mut_ptr() as *mut c_char,
+                out.len() as i32,
+            )
+        };
+        if n <= 0 {
+            return Vec::new();
+        }
+        let text = latin1(&out);
+        text.split('\n').filter(|p| !p.is_empty()).map(str::to_string).collect()
+    }
+}
+
+impl Drop for Window {
+    fn drop(&mut self) {
+        // SAFETY: closed exactly once.
+        unsafe { pc_window_close(self.raw) }
+    }
+}
+
+pub fn beep() {
+    // SAFETY: no arguments.
+    unsafe { pc_beep() }
+}
+
+pub fn clipboard_write_text(text: &str) -> bool {
+    let bytes = to_latin1(text);
+    // SAFETY: the buffer and its length are passed together.
+    unsafe { pc_clip_write_text(bytes.as_ptr() as *const c_char, bytes.len() as i32) != 0 }
+}
+
+pub fn clipboard_read_text() -> Option<String> {
+    let mut out = vec![0u8; 1 << 20];
+    // SAFETY: `out` is `outlen` bytes and is NUL-terminated by the C side.
+    let n = unsafe { pc_clip_read_text(out.as_mut_ptr() as *mut c_char, out.len() as i32) };
+    (n > 0).then(|| latin1(&out[..n as usize]))
+}
+
+pub fn open_url(url: &str) -> bool {
+    let url = cstring(url);
+    // SAFETY: NUL-terminated string.
+    unsafe { pc_open_url(url.as_ptr()) != 0 }
+}
+
+/// The last path element of an AmigaDOS or POSIX path.
+pub fn file_part(path: &str) -> &str {
+    path.rsplit(['/', ':']).next().unwrap_or(path)
+}
+
+/// The directory part of an AmigaDOS or POSIX path (`Work:Images/` for `Work:Images/a.png`).
+pub fn dir_part(path: &str) -> &str {
+    match path.rfind(['/', ':']) {
+        Some(i) => &path[..=i],
+        None => "",
+    }
+}
+
+#[allow(dead_code)]
+pub fn c_str_to_string(p: *const c_char) -> String {
+    if p.is_null() {
+        return String::new();
+    }
+    // SAFETY: the caller passes a NUL-terminated string.
+    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+}
+
diff --git a/apps/photocraft-aros/src/input.rs b/apps/photocraft-aros/src/input.rs
new file mode 100644
index 0000000000000000000000000000000000000000..689acef5e46aa0514e55a9230b63ab80253031fc
--- /dev/null
+++ b/apps/photocraft-aros/src/input.rs
@@ -0,0 +1,168 @@
+//! Translates the window's events (`ffi::PcEvent`) into egui input, the way egui-winit does for
+//! winit: pointer moves and buttons, the wheel, keys with their modifiers, typed text, and the
+//! clipboard shortcuts as `Copy` / `Cut` / `Paste` events.
+
+use egui::{Event, Key, Modifiers, MouseWheelUnit, PointerButton, Pos2, TouchPhase, pos2, vec2};
+
+use crate::ffi::{self, PcEvent};
+
+/// What one frame's worth of window events amounts to.
+#[derive(Default)]
+pub struct Input {
+    pub events: Vec<Event>,
+    pub modifiers: Modifiers,
+    pub pointer: Option<Pos2>,
+    /// A new inner size arrived (pixels).
+    pub resized: Option<(i32, i32)>,
+    pub close_requested: bool,
+    pub focus: Option<bool>,
+    /// Clipboard text asked for by the app (`ViewportCommand::RequestPaste`), delivered next frame.
+    pub paste_pending: bool,
+}
+
+impl Input {
+    pub fn modifiers_from(qualifier: u32) -> Modifiers {
+        let ctrl = qualifier & (ffi::Q_CONTROL | ffi::Q_LCOMMAND | ffi::Q_RCOMMAND) != 0;
+        Modifiers {
+            alt: qualifier & (ffi::Q_LALT | ffi::Q_RALT) != 0,
+            ctrl,
+            shift: qualifier & (ffi::Q_LSHIFT | ffi::Q_RSHIFT) != 0,
+            mac_cmd: false,
+            command: ctrl,
+        }
+    }
+
+    /// Folds one window event in, in points (`ppp` pixels per point).
+    pub fn push(&mut self, ev: &PcEvent, ppp: f32) {
+        let mods = Self::modifiers_from(ev.qualifier);
+        if mods != self.modifiers {
+            self.modifiers = mods;
+            self.events.push(Event::ModifiersChanged(mods));
+        }
+        let pos = pos2(ev.x as f32 / ppp, ev.y as f32 / ppp);
+        match ev.kind {
+            ffi::EV_CLOSE => self.close_requested = true,
+            ffi::EV_RESIZE => self.resized = Some((ev.width, ev.height)),
+            ffi::EV_FOCUS => {
+                let focused = ev.focus != 0;
+                self.focus = Some(focused);
+                self.events.push(Event::WindowFocused(focused));
+                if !focused {
+                    self.events.push(Event::PointerGone);
+                    self.pointer = None;
+                }
+            }
+            ffi::EV_MOUSE_MOVE => {
+                self.pointer = Some(pos);
+                self.events.push(Event::PointerMoved(pos));
+            }
+            ffi::EV_BUTTON => {
+                let button = match ev.button {
+                    0 => PointerButton::Primary,
+                    1 => PointerButton::Secondary,
+                    _ => PointerButton::Middle,
+                };
+                self.pointer = Some(pos);
+                self.events.push(Event::PointerButton { pos, button, pressed: ev.down != 0, modifiers: mods });
+            }
+            ffi::EV_WHEEL => {
+                self.events.push(Event::MouseWheel {
+                    unit: MouseWheelUnit::Line,
+                    delta: vec2(ev.wheel_x as f32, ev.wheel_y as f32),
+                    phase: TouchPhase::Move,
+                    modifiers: mods,
+                });
+            }
+            ffi::EV_KEY => self.key(ev, mods),
+            _ => {}
+        }
+    }
+
+    fn key(&mut self, ev: &PcEvent, mods: Modifiers) {
+        let pressed = ev.down != 0;
+        let repeat = ev.qualifier & ffi::Q_REPEAT != 0;
+        let plain = ev.plain();
+        let key = key_for(ev.rawkey, &plain);
+        // The clipboard shortcuts become egui's clipboard events (as egui-winit does), with the
+        // text read here for Paste; the app's raw input hook knows how to give them back as key
+        // presses outside text fields.
+        if pressed && mods.command && !mods.alt && !mods.shift {
+            match key {
+                Some(Key::C) => {
+                    self.events.push(Event::Copy);
+                    return;
+                }
+                Some(Key::X) => {
+                    self.events.push(Event::Cut);
+                    return;
+                }
+                Some(Key::V) => {
+                    self.events.push(Event::Paste(ffi::clipboard_read_text().unwrap_or_default()));
+                    return;
+                }
+                _ => {}
+            }
+        }
+        if let Some(key) = key {
+            self.events.push(Event::Key { key, physical_key: None, pressed, repeat, modifiers: mods });
+        }
+        if pressed && !mods.ctrl && !mods.command {
+            let text: String = ev.text().chars().filter(|c| !c.is_control()).collect();
+            if !text.is_empty() {
+                self.events.push(Event::Text(text));
+            }
+        }
+    }
+
+    /// Takes the frame's events, leaving the persistent state (modifiers, pointer).
+    pub fn take_events(&mut self) -> Vec<Event> {
+        std::mem::take(&mut self.events)
+    }
+
+}
+
+/// The logical key for a raw key code: the special keys by code (they are the same on every
+/// keymap), the others from the character the keymap gives the unshifted key.
+fn key_for(rawkey: i32, plain: &str) -> Option<Key> {
+    let special = match rawkey {
+        0x41 => Some(Key::Backspace),
+        0x42 => Some(Key::Tab),
+        0x43 => Some(Key::Enter), // keypad Enter
+        0x44 => Some(Key::Enter),
+        0x45 => Some(Key::Escape),
+        0x46 => Some(Key::Delete),
+        0x47 => Some(Key::Insert),
+        0x48 => Some(Key::PageUp),
+        0x49 => Some(Key::PageDown),
+        0x4c => Some(Key::ArrowUp),
+        0x4d => Some(Key::ArrowDown),
+        0x4e => Some(Key::ArrowRight),
+        0x4f => Some(Key::ArrowLeft),
+        0x50 => Some(Key::F1),
+        0x51 => Some(Key::F2),
+        0x52 => Some(Key::F3),
+        0x53 => Some(Key::F4),
+        0x54 => Some(Key::F5),
+        0x55 => Some(Key::F6),
+        0x56 => Some(Key::F7),
+        0x57 => Some(Key::F8),
+        0x58 => Some(Key::F9),
+        0x59 => Some(Key::F10),
+        0x4b => Some(Key::F11),
+        0x6f => Some(Key::F12),
+        0x5f => Some(Key::Insert), // Help
+        0x70 => Some(Key::Home),
+        0x71 => Some(Key::End),
+        0x40 => Some(Key::Space),
+        _ => None,
+    };
+    if special.is_some() {
+        return special;
+    }
+    let c = plain.chars().next()?;
+    if c.is_control() || c == ' ' {
+        return None;
+    }
+    let name: String = c.to_uppercase().collect();
+    Key::from_name(&name)
+}
diff --git a/apps/photocraft-aros/src/main.rs b/apps/photocraft-aros/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f5e984b98b030e7e088deacaaedba052d45dea3c
