+        }
         #[cfg(not(target_os = "aros"))]
-        let input = tokio::io::stdin();
-        self.serve_io(input, tokio::io::stdout()).await
+        self.serve_io(tokio::io::stdin(), tokio::io::stdout()).await
     }
 
     /// Run `f` on the headless session on a blocking thread.
diff --git a/crates/automation/src/server/transport.rs b/crates/automation/src/server/transport.rs
index da8737e31fb3bc46777901c5fca934e26f24d4d9..5b34fcee6f7c28b560ddf06c104d6db9d7b41553 100644
--- a/crates/automation/src/server/transport.rs
+++ b/crates/automation/src/server/transport.rs
@@ -97,21 +97,42 @@ impl PhotocraftMcp {
 /// A read from an AROS PIPE: handler returns only once the whole requested length has arrived
 /// or the writer closed it. Tokio's stdin (and std's 8 KiB buffer under it) asks for kilobytes,
 /// so a client's short request would sit unread until the client ended. Here a plain thread
-/// reads descriptor 0 one byte per call, bypassing std's buffer (see photocraft-aros-stdin), and hands
-/// each complete line (or each 64 KiB, for a very long one) to the async side. The thread ends
-/// at end of input, which is also how a stdio MCP session ends; it is never left blocked once
-/// the client has closed its side.
+/// reads descriptor 0 one byte per call, bypassing std's buffer (see photocraft-aros-stdin), and
+/// hands each complete line (or each 64 KiB of a longer one) to the async side.
+///
+/// The thread is never detached: [`StdinWorker::retire`] stops and joins it when the session
+/// ends. On a console it waits with WaitForChar in short steps and notices the stop at once.
+/// On PIPE: (and files) a read cannot be taken back once issued; the thread then ends when its
+/// pending read completes, i.e. when the client writes or closes its side. A session that ended
+/// for another reason (failed initialization, an overlong request) therefore keeps the process
+/// until the client closes standard input; retire() says so on stderr.
 #[cfg(target_os = "aros")]
-pub(crate) fn dos_stdin() -> std::io::Result<impl tokio::io::AsyncRead + Unpin + Send + 'static> {
+pub(crate) fn dos_stdin() -> std::io::Result<(impl tokio::io::AsyncRead + Unpin + Send + 'static, StdinWorker)> {
     use std::io::Read;
+    use std::sync::atomic::{AtomicBool, Ordering};
 
     const CHUNK: usize = 64 * 1024;
+    const STEP: std::time::Duration = std::time::Duration::from_millis(100);
     let mut input = photocraft_aros_stdin::take();
+    let waiter = photocraft_aros_stdin::Waiter::new();
+    let stop = std::sync::Arc::new(AtomicBool::new(false));
+    let stopped = stop.clone();
     let (tx, rx) = tokio::sync::mpsc::channel::<std::io::Result<Vec<u8>>>(64);
-    std::thread::Builder::new().name("mcp-stdin".into()).spawn(move || {
+    let thread = std::thread::Builder::new().name("mcp-stdin".into()).spawn(move || {
         let mut pending = Vec::new();
         let mut byte = [0u8; 1];
+        let mut can_wait = true;
         loop {
+            if stopped.load(Ordering::Acquire) || tx.is_closed() {
+                break;
+            }
+            if can_wait {
+                match waiter.wait(STEP) {
+                    photocraft_aros_stdin::Ready::Yes => {}
+                    photocraft_aros_stdin::Ready::Timeout => continue,
+                    photocraft_aros_stdin::Ready::Unsupported => can_wait = false,
+                }
+            }
             match input.read(&mut byte) {
                 Ok(0) => {
                     if !pending.is_empty() {
@@ -133,7 +154,32 @@ pub(crate) fn dos_stdin() -> std::io::Result<impl tokio::io::AsyncRead + Unpin +
             }
         }
     })?;
-    Ok(ChannelReader { rx, chunk: Vec::new(), pos: 0 })
+    Ok((ChannelReader { rx, chunk: Vec::new(), pos: 0 }, StdinWorker { thread, stop }))
+}
+
+/// The standard-input thread of an AROS MCP session, kept so that it can be stopped and joined.
+#[cfg(target_os = "aros")]
+pub(crate) struct StdinWorker {
+    thread: std::thread::JoinHandle<()>,
+    stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+
+#[cfg(target_os = "aros")]
+impl StdinWorker {
+    /// Stops the thread and waits for it. If it is still inside a read that cannot be taken
+    /// back, says on stderr (never stdout) that the process waits for the client to close
+    /// standard input, then waits: the thread's code must stay loaded until it returns.
+    pub(crate) fn retire(self) {
+        self.stop.store(true, std::sync::atomic::Ordering::Release);
+        let deadline = std::time::Instant::now() + std::time::Duration::from_millis(300);
+        while !self.thread.is_finished() && std::time::Instant::now() < deadline {
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        if !self.thread.is_finished() {
+            eprintln!("photocraft-cli: the MCP session has ended; waiting for the client to close standard input");
+        }
+        let _ = self.thread.join();
+    }
 }
 
 /// An `AsyncRead` over byte chunks sent from a blocking thread.
