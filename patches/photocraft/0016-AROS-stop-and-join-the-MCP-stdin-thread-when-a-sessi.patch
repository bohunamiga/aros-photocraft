index 0000000000000000000000000000000000000000..46f38706e7445df24bcf3ae80a96d6075dd99b5d
--- /dev/null
+++ b/crates/aros-stdin/build.rs
@@ -0,0 +1,54 @@
+//! Compiles `c/stdin_wait.c` with the AROS C cross compiler and links
+//! it in. The compiler and archiver come from `AROS_CC` (or `AROS_GCC`) / `AROS_AR` (the AROS
+//! build system sets them), else `<arch>-aros-cc` / `<arch>-aros-ar` on the PATH (what the Rust
+//! crosstool installs). `AROS_SDK`, when set, is passed as `--sysroot`: the C glue must see the
+//! same SDK headers as the final link, because ABIv1 and ABIv11 inline library calls differently
+//! and a mismatch fails inside the first system call rather than at build time.
+//! On any other target the file is skipped, so the workspace still type-checks on the host.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=c/stdin_wait.c");
+    println!("cargo:rerun-if-env-changed=AROS_CC");
+    println!("cargo:rerun-if-env-changed=AROS_AR");
+    println!("cargo:rerun-if-env-changed=AROS_GCC");
+    println!("cargo:rerun-if-env-changed=AROS_SDK");
+    let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    if os != "aros" {
+        return;
+    }
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let cc = std::env::var("AROS_CC").or_else(|_| std::env::var("AROS_GCC")).unwrap_or_else(|_| format!("{arch}-aros-cc"));
+    let ar = std::env::var("AROS_AR").unwrap_or_else(|_| format!("{arch}-aros-ar"));
+    let out = PathBuf::from(std::env::var("OUT_DIR").unwrap_or_default());
+    let obj = out.join("stdin_wait.o");
+    let lib = out.join("libphotocraft_aros_stdin.a");
+    let mut compile = Command::new(&cc);
+    if let Ok(sdk) = std::env::var("AROS_SDK") {
+        compile.arg(format!("--sysroot={sdk}"));
+    }
+    let status = compile.args(["-O2", "-Wall", "-Wno-unused-function", "-c", "c/stdin_wait.c", "-o"]).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{cc} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {cc}: {e}")),
+    }
+    let _ = std::fs::remove_file(&lib);
+    let status = Command::new(&ar).arg("crs").arg(&lib).arg(&obj).status();
+    match status {
+        Ok(s) if s.success() => {}
+        Ok(s) => panic_build(&format!("{ar} failed with {s}")),
+        Err(e) => panic_build(&format!("cannot run {ar}: {e}")),
+    }
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=photocraft_aros_stdin");
+}
+
+/// A build script reports its failure through its exit status; this is the one place a panic
+/// is the right tool.
+#[allow(clippy::panic)]
+fn panic_build(msg: &str) -> ! {
+    panic!("photocraft-aros-stdin build.rs: {msg}");
+}
diff --git a/crates/aros-stdin/c/stdin_wait.c b/crates/aros-stdin/c/stdin_wait.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa71e3a0189aa2a3a97157ce8b7a358d92d14cf2
--- /dev/null
+++ b/crates/aros-stdin/c/stdin_wait.c
@@ -0,0 +1,27 @@
+/*
+ * stdin_wait.c - can standard input be waited on with a timeout?
+ *
+ * The console handler answers ACTION_WAIT_CHAR (WaitForChar), so a reader can
+ * wake up regularly and notice that it should stop. The PIPE: handler does
+ * not (ERROR_ACTION_NOT_KNOWN), and a pending PIPE: read ends only when data
+ * arrives or the writer closes; nothing on the reading side can take it back.
+ */
+#include <proto/dos.h>
+#include <dos/dos.h>
+#include <stdint.h>
+
+/* The process's input handle; call on the main task, whose Input() descriptor 0 wraps. */
+uintptr_t pc_stdin_handle(void)
+{
+    return (uintptr_t)Input();
+}
+
+/* 1: a character is waiting; 0: timeout; -1: the handler cannot wait (or failed). */
+int32_t pc_stdin_wait(uintptr_t fh, int32_t micros)
+{
+    if (!fh)
+        return -1;
+    if (WaitForChar((BPTR)fh, micros))
+        return 1;
+    return IoErr() == 0 ? 0 : -1;
+}
diff --git a/crates/aros-stdin/src/lib.rs b/crates/aros-stdin/src/lib.rs
index 3f548a8f1bcb279e04e7e1deb9b51708efa6511e..e4a345d33b5828f6d017114221602a79168b99f3 100644
--- a/crates/aros-stdin/src/lib.rs
+++ b/crates/aros-stdin/src/lib.rs
@@ -14,3 +14,45 @@ pub fn take() -> std::mem::ManuallyDrop<std::fs::File> {
     // std's Stdin buffer would otherwise hold bytes this File never sees.
     std::mem::ManuallyDrop::new(unsafe { std::fs::File::from_raw_fd(0) })
 }
+
+#[cfg(target_os = "aros")]
+unsafe extern "C" {
+    fn pc_stdin_handle() -> usize;
+    fn pc_stdin_wait(fh: usize, micros: i32) -> i32;
+}
+
+/// Whether input is waiting, as far as the handler can tell.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Ready {
+    /// A character can be read without blocking.
+    Yes,
+    /// Nothing arrived within the timeout.
+    Timeout,
+    /// The handler cannot wait with a timeout (PIPE:, files): a read may block until data
+    /// or end of input.
+    Unsupported,
+}
+
+/// Waits on the process's input handle (taken when created, on the calling task).
+#[cfg(target_os = "aros")]
+#[derive(Clone, Copy)]
+pub struct Waiter(usize);
+
+#[cfg(target_os = "aros")]
+impl Waiter {
+    /// The waiter for this process's input. Call on the main task.
+    pub fn new() -> Self {
+        // SAFETY: no arguments; returns a BPTR value that stays valid for the process's life.
+        Waiter(unsafe { pc_stdin_handle() })
+    }
+
+    pub fn wait(&self, timeout: std::time::Duration) -> Ready {
+        let micros = timeout.as_micros().min(i32::MAX as u128) as i32;
+        // SAFETY: the handle came from Input() and is not closed while the process runs.
+        match unsafe { pc_stdin_wait(self.0, micros) } {
+            1 => Ready::Yes,
+            0 => Ready::Timeout,
+            _ => Ready::Unsupported,
+        }
+    }
+}
