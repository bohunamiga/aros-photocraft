 [features]
-default = ["mcp"]
-# The `mcp` subcommand (an MCP server over stdio) and the TCP bridge; off where there are no sockets.
+default = ["mcp", "bridge", "sandbox"]
+# The `mcp` subcommand: an MCP server over stdio (Tokio runtime, no networking).
 mcp = ["photocraft-automation/mcp", "dep:tokio"]
+# `mcp --bridge`: drive a running app over the TCP control connection (Tokio networking).
+bridge = ["mcp", "photocraft-automation/bridge"]
