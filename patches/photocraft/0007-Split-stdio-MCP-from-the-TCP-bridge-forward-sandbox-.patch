 use std::sync::atomic::{AtomicU64, Ordering};
 use std::time::{Duration, Instant};
 
 use serde_json::{Value, json};
-use tokio::io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader};
-use tokio::net::TcpStream;
+use tokio::io::{AsyncBufReadExt, AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, BufReader};
 use tokio::sync::Mutex;
 
 use crate::AutomationError;
 use crate::budgets::MAX_RESPONSE_BYTES;
 use crate::security::{AUTH_METHOD, IO_TIMEOUT, MAX_REQUEST_BYTES, validate_token};
 
-type Conn = (BufReader<tokio::net::tcp::OwnedReadHalf>, tokio::net::tcp::OwnedWriteHalf);
+/// The reading half of one control connection.
+pub type BoxReader = Box<dyn AsyncRead + Send + Unpin>;
+/// The writing half of one control connection.
+pub type BoxWriter = Box<dyn AsyncWrite + Send + Unpin>;
+/// Opens one control connection to an address (`127.0.0.1:7878`). The default is Tokio's TCP
+/// (feature `bridge`); a target whose sockets Tokio cannot drive supplies its own.
+pub type Connector = Arc<dyn Fn(String) -> Pin<Box<dyn Future<Output = std::io::Result<(BoxReader, BoxWriter)>> + Send>> + Send + Sync>;
+
+type Conn = (BufReader<BoxReader>, BoxWriter);
+
+/// Tokio's TCP, when this build has it.
+#[cfg(feature = "bridge")]
+fn default_connector() -> Option<Connector> {
+    Some(Arc::new(|addr: String| {
+        Box::pin(async move {
+            let (r, w) = tokio::net::TcpStream::connect(&addr).await?.into_split();
+            Ok((Box::new(r) as BoxReader, Box::new(w) as BoxWriter))
+        })
+    }))
+}
+
+#[cfg(not(feature = "bridge"))]
+fn default_connector() -> Option<Connector> {
+    None
+}
 
