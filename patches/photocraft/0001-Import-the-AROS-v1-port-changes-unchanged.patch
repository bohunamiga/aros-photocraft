+/// The subset of `cap_std::fs` this module uses, over `std::fs` beneath a root directory, for
+/// targets cap-std does not build for. The request paths it is handed have already passed
+/// [`relative_path`] (relative, no `..`, no prefixes), and it refuses anything else itself; what
+/// it cannot do is stop a symlink below the root from pointing outside it.
+#[cfg(not(feature = "sandbox"))]
+mod plain_dir {
+    use std::io;
+    use std::path::{Component, Path, PathBuf};
+
+    pub fn ambient_authority() {}
+
+    pub struct Dir {
+        root: PathBuf,
+    }
+
+    pub struct File(std::fs::File);
+
+    pub use std::fs::OpenOptions;
+
+    fn below(root: &Path, path: &Path) -> io::Result<PathBuf> {
+        if path.components().any(|c| !matches!(c, Component::Normal(_) | Component::CurDir)) {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "path leaves the automation root"));
+        }
+        Ok(root.join(path))
+    }
+
+    impl Dir {
+        pub fn open_ambient_dir(path: &Path, (): ()) -> io::Result<Self> {
+            let root = std::path::absolute(path)?;
+            if !std::fs::metadata(&root)?.is_dir() {
+                return Err(io::Error::new(io::ErrorKind::NotADirectory, "not a directory"));
+            }
+            Ok(Self { root })
+        }
+
+        pub fn open<P: AsRef<Path>>(&self, path: P) -> io::Result<File> {
+            std::fs::File::open(below(&self.root, path.as_ref())?).map(File)
+        }
+
+        pub fn open_with<P: AsRef<Path>>(&self, path: P, options: &OpenOptions) -> io::Result<File> {
+            options.open(below(&self.root, path.as_ref())?).map(File)
+        }
+
+        pub fn open_dir<P: AsRef<Path>>(&self, path: P) -> io::Result<Self> {
+            let root = below(&self.root, path.as_ref())?;
+            if !std::fs::metadata(&root)?.is_dir() {
+                return Err(io::Error::new(io::ErrorKind::NotADirectory, "not a directory"));
+            }
+            Ok(Self { root })
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(&self, path: P) -> io::Result<()> {
+            std::fs::create_dir_all(below(&self.root, path.as_ref())?)
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(&self, path: P) -> io::Result<()> {
+            std::fs::remove_file(below(&self.root, path.as_ref())?)
+        }
+
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(&self, from: P, to_dir: &Self, to: Q) -> io::Result<()> {
+            std::fs::rename(below(&self.root, from.as_ref())?, below(&to_dir.root, to.as_ref())?)
+        }
+    }
+
+    impl File {
+        pub fn metadata(&self) -> io::Result<std::fs::Metadata> {
+            self.0.metadata()
+        }
+
+        pub fn sync_all(&self) -> io::Result<()> {
+            self.0.sync_all()
+        }
+
+        pub fn into_std(self) -> std::fs::File {
+            self.0
+        }
+    }
+
+    impl io::Read for File {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            self.0.read(buf)
+        }
+    }
+
+    impl io::Write for File {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            self.0.write(buf)
+        }
+
+        fn flush(&mut self) -> io::Result<()> {
+            self.0.flush()
+        }
+    }
+}
