+/// The folder (`None` for a bare file name) and the file name of `target`. On AROS a path may
+/// name a device or volume with a colon (`Work:a.png`, `T:x`), which `Path` does not know as a
+/// separator; the folder keeps its trailing separator so [`join_in`] can put files beside it.
+fn split_dir_and_name(target: &Path) -> Option<(Option<PathBuf>, String)> {
+    if cfg!(target_os = "aros") {
+        let text = target.to_string_lossy();
+        let (dir, name) = match text.rfind(['/', ':']) {
+            Some(i) => (Some(PathBuf::from(&text[..=i])), &text[i + 1..]),
+            None => (None, &text[..]),
+        };
+        return (!name.is_empty()).then(|| (dir, name.to_string()));
+    }
+    let name = target.file_name()?.to_string_lossy().into_owned();
+    Some((target.parent().filter(|d| !d.as_os_str().is_empty()).map(Path::to_path_buf), name))
+}
+
+/// `file` inside `dir`, where `dir` may end in a separator already (see [`split_dir_and_name`]).
+fn join_in(dir: &Path, file: &str) -> PathBuf {
+    let text = dir.to_string_lossy();
+    if cfg!(target_os = "aros") && text.ends_with([':', '/']) {
+        return PathBuf::from(format!("{text}{file}"));
+    }
+    dir.join(file)
+}
