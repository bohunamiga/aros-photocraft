+//! Unbuffered standard input on AROS.
+//!
+//! A read from an AROS PIPE: handler returns only when the requested length has arrived or the
+//! writer closed it, so std's buffered `Stdin` (8 KiB reads) waits for data a request-response
+//! peer never sends. Reading descriptor 0 directly with small reads avoids that. Duplicating
+//! the descriptor (`try_clone_to_owned`) is not an option on the tested ABIv11 C library: its
+//! fcntl lacks F_DUPFD_CLOEXEC and the call fails with EINVAL.
+
+#[cfg(target_os = "aros")]
+pub fn take() -> std::mem::ManuallyDrop<std::fs::File> {
+    use std::os::fd::FromRawFd;
+    // SAFETY: descriptor 0 stays open for the life of the process; ManuallyDrop keeps this
+    // File from closing it. The caller must be the only reader of standard input, since
+    // std's Stdin buffer would otherwise hold bytes this File never sees.
+    std::mem::ManuallyDrop::new(unsafe { std::fs::File::from_raw_fd(0) })
+}
