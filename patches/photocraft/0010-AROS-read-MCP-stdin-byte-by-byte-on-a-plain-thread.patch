+/// Standard input for the MCP server on AROS.
+///
+/// A read from an AROS PIPE: handler returns only once the whole requested length has arrived
+/// or the writer closed it. Tokio's stdin (and std's 8 KiB buffer under it) asks for kilobytes,
+/// so a client's short request would sit unread until the client ended. Here a plain thread
+/// reads descriptor 0 one byte per call, bypassing std's buffer (see photocraft-aros-stdin), and hands
+/// each complete line (or each 64 KiB, for a very long one) to the async side. The thread ends
+/// at end of input, which is also how a stdio MCP session ends; it is never left blocked once
+/// the client has closed its side.
+#[cfg(target_os = "aros")]
+pub(crate) fn dos_stdin() -> std::io::Result<impl tokio::io::AsyncRead + Unpin + Send + 'static> {
+    use std::io::Read;
+
+    const CHUNK: usize = 64 * 1024;
+    let mut input = photocraft_aros_stdin::take();
+    let (tx, rx) = tokio::sync::mpsc::channel::<std::io::Result<Vec<u8>>>(64);
+    std::thread::Builder::new().name("mcp-stdin".into()).spawn(move || {
+        let mut pending = Vec::new();
+        let mut byte = [0u8; 1];
+        loop {
+            match input.read(&mut byte) {
+                Ok(0) => {
+                    if !pending.is_empty() {
+                        let _ = tx.blocking_send(Ok(pending));
+                    }
+                    break;
+                }
+                Ok(_) => {
+                    pending.push(byte[0]);
+                    if (byte[0] == b'\n' || pending.len() >= CHUNK) && tx.blocking_send(Ok(std::mem::take(&mut pending))).is_err() {
+                        break;
+                    }
+                }
+                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(e) => {
+                    let _ = tx.blocking_send(Err(e));
+                    break;
+                }
+            }
+        }
+    })?;
+    Ok(ChannelReader { rx, chunk: Vec::new(), pos: 0 })
+}
+
+/// An `AsyncRead` over byte chunks sent from a blocking thread.
+#[cfg(target_os = "aros")]
+struct ChannelReader {
+    rx: tokio::sync::mpsc::Receiver<std::io::Result<Vec<u8>>>,
+    chunk: Vec<u8>,
+    pos: usize,
+}
+
+#[cfg(target_os = "aros")]
+impl tokio::io::AsyncRead for ChannelReader {
+    fn poll_read(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+        out: &mut tokio::io::ReadBuf<'_>,
+    ) -> std::task::Poll<std::io::Result<()>> {
+        use std::task::Poll;
+        loop {
+            if self.pos < self.chunk.len() {
+                let n = out.remaining().min(self.chunk.len() - self.pos);
+                let start = self.pos;
+                out.put_slice(&self.chunk[start..start + n]);
+                self.pos += n;
+                return Poll::Ready(Ok(()));
+            }
+            match self.rx.poll_recv(cx) {
+                Poll::Ready(Some(Ok(chunk))) => {
+                    self.chunk = chunk;
+                    self.pos = 0;
+                }
+                Poll::Ready(Some(Err(e))) => return Poll::Ready(Err(e)),
+                // The thread ended: end of input.
+                Poll::Ready(None) => return Poll::Ready(Ok(())),
+                Poll::Pending => return Poll::Pending,
+            }
+        }
+    }
+}
